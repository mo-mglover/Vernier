module test_vernier_mod
  @suite(name='test_vernier_mod_suite')

  use vernier_mod
  !$ use omp_lib
  use mpi
  use pfunit
  implicit none

  integer, parameter :: dp = 8

  @TestCase
  type, extends(MPITestCase), public :: test_vernier_type
    private
  contains
    procedure :: setup
    procedure :: teardown
    procedure :: test_vernier_timings
    procedure :: test_vernier_tags
    procedure :: test_vernier_affinity
    procedure :: test_vernier_affinity_default
  end type test_vernier_type

contains

  !-----------------------------------------------------------------------------
  ! Setup routine
  !-----------------------------------------------------------------------------

  subroutine setup(this)
    implicit none
    
    class(test_vernier_type), intent(inout) :: this

  end subroutine setup

  !-----------------------------------------------------------------------------
  ! Teardown routine
  !-----------------------------------------------------------------------------

  subroutine teardown(this)
    implicit none
    
    class(test_vernier_type), intent(inout) :: this

  end subroutine teardown

  !-----------------------------------------------------------------------------
  ! Test Vernier timings
  !-----------------------------------------------------------------------------

  @test(npes=[1,2])
  subroutine test_vernier_timings(this)
    implicit none

    class(test_vernier_type), intent(inout) :: this

    ! Timer declarations
    real(kind=dp) :: t1, t2, actual_time

    ! Handle declarations
    integer(kind=vik) :: prof_main

    ! Error handler
    integer :: ierr

    ! Initialise Vernier
    call vernier_init(this%getMpiCommunicator())

    ! Start timing: noddy way, and using Profiler.
    call vernier_start(prof_main, 'FULL')
    t1 = vernier_get_wtime()

    ! Time a region
    block
      integer(kind=vik) :: prof_sub
      call vernier_start(prof_sub, 'MAIN_SUB')
      call sleep(1);
      call vernier_stop(prof_sub)
    end block

    ! Time nested regions on many threads.
    !$OMP PARALLEL
    block
      integer(kind=vik) :: prof_sub
      integer(kind=vik) :: prof_sub2
      call vernier_start(prof_sub, "MAIN_SUB")
      call sleep(1);

      ! Time nested region
      call vernier_start(prof_sub2, "MAIN_SUB2")
      call sleep(1);
      call vernier_stop(prof_sub2)

      ! Outer region end.
      call vernier_stop(prof_sub)
    end block
    !$OMP END PARALLEL

    ! Give the main regions some substantial execution time.
    call sleep(2);

    ! End of profiling; record t2 immediately before.
    t2 = vernier_get_wtime()
    call vernier_stop(prof_main)

    assertions: block
      real(kind=vrk) :: profiler_wallclock_time

      actual_time = t2 - t1
      profiler_wallclock_time = vernier_get_total_walltime(prof_main, 0_vik)

      @assertEqual(actual_time, profiler_wallclock_time, tolerance=1.0e-4_dp)
    end block assertions

    ! Write profile and finalize.
    call vernier_write()

    call vernier_finalize()

  end subroutine test_vernier_timings

  !------------------------------------------------------------------------------
  ! Test Vernier tags
  !------------------------------------------------------------------------------

  @test(npes=[1,2])
  subroutine test_vernier_tags(this)
    implicit none

    class(test_vernier_type), intent(inout) :: this

    integer(kind=vik) :: vnr_handle

    call vernier_init(                                &
      client_comm_handle = this%getMpiCommunicator(), &
      tag = "TAGTEST")

    call vernier_start(vnr_handle, "tagtest_main")
    call vernier_stop(vnr_handle)
    call vernier_write()

    call vernier_finalize()

  end subroutine test_vernier_tags

  !------------------------------------------------------------------------------
  ! Test Vernier affinity - specific filename
  !
  ! Checks that a file with the specified name is created.
  !------------------------------------------------------------------------------

  @test(npes=[1,2])
  subroutine test_vernier_affinity(this)
    implicit none

    class(test_vernier_type), intent(inout) :: this

    character(len=40) :: filename
    logical :: file_exists
    integer :: comm_rank
    integer :: comm_size
    integer :: ierr

    call vernier_init(client_comm_handle = this%getMpiCommunicator())

    ! Generate the filename to write. Vernier does not expose MPI contexts,
    ! so get the communicator size with direct MPI call.
    call mpi_comm_size(this%getMpiCommunicator(), comm_size, ierr)
    write(filename, '(a,i0,a)') "vernier-affinity-comm-size", comm_size, ".txt" 

    ! Write affinity map.
    call vernier_write_affinity_map(trim(filename))

    call check_and_delete_file(this%getMpiCommunicator(), trim(filename))

    call vernier_finalize()

  end subroutine test_vernier_affinity

  !------------------------------------------------------------------------------
  ! Test Vernier affinity - default filename
  !
  ! Checks that an affinity map file with the default filename is created.
  !
  ! Only test with one communicator size to avoid race condition on writing a
  ! file of the default name.
  !------------------------------------------------------------------------------

  @test(npes=[1])
  subroutine test_vernier_affinity_default(this)
    implicit none

    class(test_vernier_type), intent(inout) :: this

    call vernier_init(client_comm_handle = this%getMpiCommunicator())

    ! Write affinity map.
    call vernier_write_affinity_map()

    ! Check file exists with default filename.
    call check_and_delete_file(      &
        this%getMPICommunicator(),   &
       'vernier-affinity-map.txt')

    call vernier_finalize()

  end subroutine test_vernier_affinity_default

  !-------------------------------------------------------------------------------
  ! Helper routine to check if file exists, then delete if it does. Deleting
  ! afterwards allows clean re-tests.
  !-------------------------------------------------------------------------------

  subroutine check_and_delete_file(comm, filename)
    implicit none

    ! Arguments
    integer,          intent(in) :: comm
    character(len=*), intent(in) :: filename

    ! Local parameters
    integer :: file_unit = 10

    ! Local variables
    logical :: file_exists
    integer :: iostat
    logical :: on_root
    integer :: my_rank
    integer :: ierr

    ! Synchronise - file must have been created.
    call mpi_barrier(comm, ierr)

    ! Establish whether this is the rank designated as root.
    call mpi_comm_rank(comm, my_rank, ierr)
    on_root = (my_rank == 0)

    ! Check and delete on root only.
    if (on_root) then
      inquire(file=trim(filename), exist=file_exists)
      @assertTrue(file_exists)

      ! Remove the test artifact.
      open(unit=file_unit, iostat=iostat, file=trim(filename), status='old')
      if (iostat==0) close (unit=file_unit, status='delete')
    end if

  end subroutine check_and_delete_file

end module test_vernier_mod
